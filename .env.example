# Copy this file to .env and fill in values you want to use.
# Everything here is optional — the bot runs console-only without it.

# Optional Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Auto trading -------------------------------------------------------------
# paper (default, simulated) | testnet (Binance spot testnet) | live (REAL money)
TRADING_MODE=paper
# Required in addition to TRADING_MODE=live, exactly: YES_REAL_MONEY
LIVE_TRADING_CONFIRM=
# Binance API key: enable "Spot & Margin Trading" ONLY — never "Withdrawals" —
# and restrict it to your server's IP. Testnet keys: https://testnet.binance.vision
BINANCE_API_KEY=
BINANCE_API_SECRET=
# The Trade page's "Binance" switch uses the spot testnet when 1, the real exchange when 0
BINANCE_TESTNET=0
# Auto trade on/off and the trading limits are set on the dashboard's Settings page (saved in SQLite).
DB_PATH=trading.db

# --- Email on every trade open/close ------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=0
SMTP_USER=
# Gmail: use an App Password (Google account > Security > App passwords)
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
