# Copy this file to .env and fill in your MySQL login — that's the only thing in .env.
# The database must already exist; the app creates its tables on first start.
# Binance API key/secret/URL, Telegram and SMTP are stored in the MySQL
# `credentials` table and edited on the dashboard: Settings -> Credentials.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=crypto_bot
MYSQL_USER=
MYSQL_PASSWORD=
